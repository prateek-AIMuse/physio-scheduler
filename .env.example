# Copy to .env.local for local development (or .dev.vars for `npm run preview`). Never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only

# Public address of the app, used in login and payment links sent on WhatsApp
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The physio's login email(s), comma-separated
ADMIN_EMAILS=physio@example.com

# Any long random string; the hourly reminders job sends it (see .github/workflows/reminders.yml)
CRON_SECRET=change-me

# Optional, for automatic WhatsApp sending (Meta WhatsApp Cloud API)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_LANGUAGE=en
